# Supabase (Lane 2 backend). Copy to .env and fill in. Both values are public-safe (the publishable
# key is designed for browsers; RLS does the protecting). Absent => the app runs guest/offline only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: legacy Cloudflare Worker sync URL (fallback transport; retired once Supabase is live).
# VITE_SYNC_URL=https://cruise-sync.charlesbee.workers.dev
